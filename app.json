{
  "expo": {
    "name": "Clothing Sales",
    "slug": "clothing-sales",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/clothing-app-icon.png",
    "scheme": "clothing-sales",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thethtun.clothingsales"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/clothing-app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.thethtun.clothingsales"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2907496a-d4e4-46c9-90bb-e4fc4989f47c"
      }
    },
    "owner": "thethtun"
  }
}
