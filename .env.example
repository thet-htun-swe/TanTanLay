# Copy this file to .env and fill in the real values.
# Expo only exposes variables that start with EXPO_PUBLIC_.
# Never put the database password or the service_role / secret key here.

# Cloudflare Worker proxy (default). For direct access use https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://<worker>.workers.dev
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
